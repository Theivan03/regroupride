<?xml version="1.0" encoding="utf-8"?>
<!-- Botones de aviso en la pantalla de bloqueo, mientras se rueda en grupo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/rg_sos"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/rg_btn_sos"
        android:gravity="center"
        android:maxLines="1"
        android:text="SOS"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rg_averia"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/rg_btn_averia"
        android:gravity="center"
        android:maxLines="1"
        android:text="Avería"
        android:textColor="#2A1D00"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rg_gasolina"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_weight="1"
        android:background="@drawable/rg_btn_gas"
        android:gravity="center"
        android:maxLines="1"
        android:text="Gasolina"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
