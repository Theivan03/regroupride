<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso ya enviado: qué se envió y el botón para cancelarlo, a la vista aunque el aviso esté recogido. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rg_sent_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/rg_sent_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
    </LinearLayout>

    <TextView
        android:id="@+id/rg_cancel"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:background="@drawable/rg_btn_cancel"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="Cancelar aviso"
        android:textColor="@color/rg_gas_fg"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
